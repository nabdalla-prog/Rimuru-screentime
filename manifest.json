{
  "schemaVersion": 1,
  "id": "rimuru.screentime",
  "name": "Screen Time",
  "version": "0.6.1",
  "author": "nabdalla",
  "description": "Daily screen time per app in your Omarchy bar: sees what runs inside terminals, names Steam games, folds browsers and web apps. The popup has a donut chart, a 52-week trend, insights, a yearly overview that reaches back to your first day, a daily goal, a settings menu and an optional faint background picture. Fully local: nothing leaves your machine.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "qml/Service.qml",
    "barWidget": "qml/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Screen Time",
    "description": "Today's screen time per app",
    "category": "Wellbeing",
    "allowMultiple": false,
    "defaultSection": "right",
    "schema": [
      {
        "key": "dailyGoalHours",
        "type": "integer",
        "label": "Daily goal (hours, 0 = off)",
        "min": 0,
        "max": 24,
        "step": 1,
        "defaultValue": 0
      },
      {
        "key": "weeks",
        "type": "enum",
        "label": "Weekly graph reach (weeks)",
        "options": [
          "12",
          "24",
          "36",
          "52"
        ],
        "defaultValue": "52"
      },
      {
        "key": "iconOnly",
        "type": "boolean",
        "label": "Icon only in the bar",
        "defaultValue": false
      },
      {
        "key": "ignoredApps",
        "type": "string",
        "label": "Ignored apps",
        "defaultValue": "",
        "description": "Comma-separated app names that are never counted."
      },
      {
        "key": "appNames",
        "type": "string",
        "label": "Custom app names",
        "defaultValue": "",
        "description": "app=Name pairs, comma-separated, e.g. zen=Browser, foot=Terminal."
      },
      {
        "key": "backgroundMode",
        "type": "enum",
        "label": "Background picture",
        "options": [
          "off",
          "slime",
          "image"
        ],
        "defaultValue": "slime"
      },
      {
        "key": "backgroundStrength",
        "type": "enum",
        "label": "Background strength (1 subtle, 2 medium, 3 strong)",
        "options": [
          "1",
          "2",
          "3"
        ],
        "defaultValue": "1"
      }
    ]
  },
  "license": "MIT",
  "homepage": "https://github.com/nabdalla-prog/Rimuru-screentime"
}
